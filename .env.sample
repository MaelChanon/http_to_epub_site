HOST=localhost
PORT=3000

DATABASE_URL=postgres://user:secret@localhost:5432/mydatabasename

SESSION_SECRET=dev-only-secret-change-me
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173

REDIS_URL=redis://localhost:6379

POSTGRES_USER=user
POSTGRES_PASSWORD=secret
POSTGRES_DB=mydatabasename

# S3 (Garage) — bucket "manga" et clé d'accès à créer après le premier démarrage (voir README/instructions).
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=manga
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
