HOST=localhost
PORT=3000

DATABASE_URL=postgres://user:secret@localhost:5432/mydatabasename

SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Read the client IP from X-Forwarded-For (rate limiting). Only enable it when a
# reverse proxy sets that header, otherwise the value is caller-controlled.
TRUST_PROXY=false

REDIS_URL=redis://localhost:6379

POSTGRES_USER=user
POSTGRES_PASSWORD=secret
POSTGRES_DB=mydatabasename

S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=manga
S3_USER_BUCKET=user
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

INVITE_TTL_SECONDS=172800
PASSWORD_RESET_TTL_SECONDS=3600
