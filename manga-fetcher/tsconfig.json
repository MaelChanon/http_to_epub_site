{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"rootDir": "src",
		"outDir": "lib",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["lib"]
}
