 
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mydatabasename

# Origine publique unique (nginx) devant front + back, ex: https://manga.example.com
CORS_ALLOWED_ORIGINS=https://change-me.example.com

# L'api est derrière nginx : sans ça, le rate limiting des routes non
# authentifiées compte toutes les requêtes sur l'IP du proxy.
TRUST_PROXY=true

# L'api parle à garage en interne (réseau docker "edge", voir
# docker-compose.prod.yml) pour toutes les opérations serveur (upload,
# download, liste...). S3_PUBLIC_ENDPOINT ne sert qu'à SIGNER les URLs
# présignées que le navigateur va effectivement appeler (téléchargement de
# cover, d'epub...), donc doit être une adresse joignable par le navigateur
# (domaine ou IP publique), pas "garage" (nom de service interne).
#
# Doit être en https : toutes les images et tous les téléchargements sont des
# redirections depuis une page https vers cette URL présignée. En http le
# navigateur bloque la requête (contenu mixte) et la signature SigV4 partirait
# en clair. Garage n'écoute que sur 127.0.0.1:3900, donc il faut de toute façon
# un vhost nginx devant, avec TLS et `proxy_set_header Host $host;` — la
# signature couvre le Host et le chemin, un proxy qui les réécrit invalide
# toutes les URLs présignées.
S3_PUBLIC_ENDPOINT=https://s3.change-me.example.com

# Bucket + clé à créer une fois après le premier démarrage de garage, voir
# doc/s3.md.
S3_BUCKET=manga
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
